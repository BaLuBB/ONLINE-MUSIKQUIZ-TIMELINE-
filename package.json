{
  "name": "timeline-musikquiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:demo": "VITE_ENABLE_LOCAL_MODE=true vite build -c vite.demo.config.ts",
