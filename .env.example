# ---- Frontend (öffentlich, wird in den Browser-Build eingebettet) ----
# Supabase-Projekt-URL und der ÖFFENTLICHE anon/publishable Key.
# Niemals den service_role-Key hier eintragen!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Lokaler Entwicklungsmodus (ohne Backend) auch im Produktions-Build erlauben.
# Im `npm run dev` ist er automatisch aktiv, solange kein Supabase konfiguriert ist.
VITE_ENABLE_LOCAL_MODE=false
# Modus ohne Supabase: p2p = Geräte-zu-Gerät-Spiel (Host-Browser ist der Server), local = nur ein Browser (Tabs).
# Im Dev-Server sind beide verfügbar (Standard: local); Produktions-Builds enthalten nur, was per
# VITE_ENABLE_P2P=true bzw. VITE_ENABLE_LOCAL_MODE=true eingeschaltet wird.
VITE_BACKEND=
VITE_ENABLE_P2P=false
# Eigener PeerJS-Signalserver (optional; Standard: kostenloser PeerJS-Cloud-Broker) und TURN/STUN-Server
VITE_PEER_HOST=
VITE_PEER_PORT=
VITE_PEER_PATH=
VITE_PEER_SECURE=
VITE_ICE_SERVERS=
# Lokaler Testmodus: demo = nur synthetische Töne; sonst iTunes-Vorschauen mit Rückfall auf Demo-Töne.
VITE_LOCAL_AUDIO=

# ---- Edge Function (Server-Secrets, nur via `supabase secrets set`) ----
# SUPABASE_URL und SUPABASE_SERVICE_ROLE_KEY stellt Supabase der Function automatisch bereit.
# Audioquelle: itunes (30s-Vorschauen der iTunes Search API) | demo (synthetische Testtöne)
AUDIO_PROVIDER=itunes
# Ländercode für die iTunes-Suche (beeinflusst Verfügbarkeit)
ITUNES_COUNTRY=DE
# Erlaubte Origin für CORS der Function (z. B. https://timeline.example.com); * für Entwicklung
ALLOWED_ORIGIN=*
